# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.
# No GitHub Actions esses mesmos nomes são lidos dos Secrets do repositório.

# Conta existente no https://www.automationexercise.com (login web e API verifyLogin)
LOGIN_EMAIL=
LOGIN_PASSWORD=

# ID de uma action pública do Trello (GET https://api.trello.com/1/actions/{id})
TRELLO_ACTION_ID=
